; Engine configuration file.
; Godot 4.8-beta1 (version string 4.8.beta1).

config_version=5

[application]

config/name="Lost Hotswap Test"
config/description="End-to-end test of the Lost framework hot-swap asset pipeline."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

AssetManager="*res://addons/lost_framework/modules/asset_manager/asset_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/lost_framework/plugin.cfg")

[lost_framework]

asset_manager/remote_enabled=true
asset_manager/base_url="https://slost.github.io/lost-hotswap-test"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.106, 0.141, 0.188, 1)
textures/canvas_textures/default_texture_filter=0
